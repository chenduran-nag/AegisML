# Environment & Secret Keys (CRITICAL: never commit API keys)
.env
.env.*
*.env

# Virtual Environment
.venv/
env/
venv/

# SQLite databases & temp state files generated at runtime
*.db
*.db-journal
*.db-shm
*.db-wal

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Temporary files & Model Artifacts
.~*.pptx
saved_models/

# Generated compliance artifacts (model cards, AIBOM, Annex IV drafts)
artifacts/

# IDE & System files
.DS_Store
.vscode/
.idea/

# Local test fixtures (downloaded, not part of the repo)
adult_income.csv
static/adult_*.csv

# Evaluation: downloaded OpenML datasets, and throwaway --quick smoke-test output.
# experiments/results/ and experiments/planner_cache/ ARE committed: together they
# reproduce the published numbers without a Groq key.
experiments/.data_cache/
experiments/results_quick/

# Reviewer roster: bearer tokens for governance decisions. reviewers.example.yaml
# IS committed; the real roster never is.
reviewers.yaml
